{
  "Comment": "Tupper Guardian: one execution per Telegram update. A stored item keeps its execution alive through the waits, its question turn and the human-in-the-loop question.",
  "QueryLanguage": "JSONata",
  "StartAt": "Route",
  "States": {
    "Route": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.callback_query) %}",
          "Next": "ResolveButton"
        },
        {
          "Condition": "{% $exists($states.input.message) %}",
          "Next": "Understand"
        }
      ],
      "Default": "Done"
    },
    "Understand": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${UnderstandFunctionArn}",
        "Payload": {
          "message": "{% $states.input.message %}"
        }
      },
      "Assign": {
        "ctx": "{% $states.result.Payload %}",
        "chat": "{% $states.result.Payload.chat_id %}",
        "cb": ""
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "chat": "{% $states.input.message.chat.id %}"
          },
          "Next": "NotifyError"
        }
      ],
      "Next": "ByIntent"
    },
    "ByIntent": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $ctx.intent = 'store' %}",
          "Next": "Store"
        },
        {
          "Condition": "{% $ctx.intent = 'consumed' or $ctx.intent = 'discarded' %}",
          "Next": "Consume"
        },
        {
          "Condition": "{% $ctx.intent = 'list' %}",
          "Next": "List"
        },
        {
          "Condition": "{% $ctx.intent = 'invite' %}",
          "Next": "Invite"
        },
        {
          "Condition": "{% $ctx.intent = 'link' %}",
          "Next": "Link"
        }
      ],
      "Default": "PlainReply"
    },
    "Store": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "store",
          "chat_id": "{% $chat %}",
          "first_name": "{% $ctx.first_name %}",
          "food": "{% $ctx.food %}",
          "category": "{% $ctx.category %}"
        }
      },
      "Assign": {
        "t": "{% $states.result.Payload %}",
        "asks": 0
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ConfirmStored"
    },
    "ConfirmStored": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "stored",
          "data": "{% $t %}"
        }
      },
      "Next": "HasReminder"
    },
    "HasReminder": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $t.remind_at != '' %}",
          "Next": "WaitForReminder"
        }
      ],
      "Default": "WaitForExpiry"
    },
    "WaitForReminder": {
      "Type": "Wait",
      "Timestamp": "{% $t.remind_at %}",
      "Next": "CheckBeforeReminder"
    },
    "CheckBeforeReminder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TuppersTableName}",
        "Key": {
          "chat_id": {
            "S": "{% $t.fridge_key %}"
          },
          "item_id": {
            "S": "{% $t.item_id %}"
          }
        },
        "ConsistentRead": true
      },
      "Assign": {
        "status": "{% $exists($states.result.Item.status.S) ? $states.result.Item.status.S : 'GONE' %}"
      },
      "Next": "StillActiveForReminder"
    },
    "StillActiveForReminder": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $status = 'ACTIVE' %}",
          "Next": "SendReminder"
        }
      ],
      "Default": "Done"
    },
    "SendReminder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "reminder",
          "data": "{% $t %}"
        }
      },
      "Next": "WaitForExpiry"
    },
    "WaitForExpiry": {
      "Type": "Wait",
      "Timestamp": "{% $t.expires_at %}",
      "Next": "CheckBeforeAsk"
    },
    "CheckBeforeAsk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TuppersTableName}",
        "Key": {
          "chat_id": {
            "S": "{% $t.fridge_key %}"
          },
          "item_id": {
            "S": "{% $t.item_id %}"
          }
        },
        "ConsistentRead": true
      },
      "Assign": {
        "status": "{% $exists($states.result.Item.status.S) ? $states.result.Item.status.S : 'GONE' %}"
      },
      "Next": "StillActiveForAsk"
    },
    "StillActiveForAsk": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $status = 'ACTIVE' %}",
          "Next": "ClaimTurn"
        }
      ],
      "Default": "Done"
    },
    "ClaimTurn": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "claim",
          "chat_id": "{% $chat %}",
          "item_id": "{% $t.item_id %}",
          "fridge_key": "{% $t.fridge_key %}"
        }
      },
      "Comment": "One question is open per person. The turn is a conditional write on the asker's profile.",
      "Assign": {
        "turn": "{% $states.result.Payload %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "HasTurn"
    },
    "HasTurn": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $turn.granted %}",
          "Next": "AskWhatHappened"
        }
      ],
      "Default": "WaitTurn"
    },
    "WaitTurn": {
      "Comment": "Another question is open for this person. Pauses until that one is answered (task token) or the poll interval passes, then tries again.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "wait_turn",
          "item_id": "{% $t.item_id %}",
          "fridge_key": "{% $t.fridge_key %}",
          "task_token": "{% $states.context.Task.Token %}"
        }
      },
      "TimeoutSeconds": "{% $t.turn_poll_seconds %}",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Next": "CheckBeforeAsk"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Escalate"
        }
      ],
      "Next": "CheckBeforeAsk"
    },
    "AskWhatHappened": {
      "Comment": "Human in the loop: sends the question with buttons and pauses until a button press releases the task token. A timeout, or any failure, leaves the item flagged for review and frees the turn.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "ask",
          "data": "{% $merge([$t, {'last_chance': $asks >= 2, 'waiting': $turn.waiting}]) %}",
          "task_token": "{% $states.context.Task.Token %}"
        }
      },
      "TimeoutSeconds": "{% $t.ask_timeout_seconds %}",
      "Assign": {
        "answer": "{% $states.result.action %}",
        "asks": "{% $asks + 1 %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Next": "Escalate"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Escalate"
        }
      ],
      "Next": "AfterAnswer"
    },
    "AfterAnswer": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $answer = 'snooze' and $asks < 3 %}",
          "Next": "WaitSnooze"
        },
        {
          "Condition": "{% $answer = 'snooze' %}",
          "Next": "Escalate"
        }
      ],
      "Default": "Done"
    },
    "WaitSnooze": {
      "Type": "Wait",
      "Seconds": "{% $t.snooze_seconds %}",
      "Next": "CheckBeforeAsk"
    },
    "Escalate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "escalate",
          "chat_id": "{% $chat %}",
          "item_id": "{% $t.item_id %}",
          "fridge_key": "{% $t.fridge_key %}"
        }
      },
      "Comment": "Nothing disappears by silence: the item stays in the fridge flagged for review.",
      "Assign": {
        "e": "{% $states.result.Payload %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "WasEscalated"
    },
    "WasEscalated": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $e.escalated %}",
          "Next": "NotifyUnanswered"
        }
      ],
      "Default": "HasWaiting"
    },
    "NotifyUnanswered": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "unanswered",
          "data": "{% $e %}"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HasOthers"
        }
      ],
      "Next": "HasOthers"
    },
    "HasOthers": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($e.others) > 0 %}",
          "Next": "NotifyOthers"
        }
      ],
      "Default": "HasWaiting"
    },
    "NotifyOthers": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_ids": "{% $e.others %}",
          "kind": "escalation",
          "data": "{% $e %}"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HasWaiting"
        }
      ],
      "Next": "HasWaiting"
    },
    "HasWaiting": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $e.wake_token != '' %}",
          "Next": "WakeWaiting"
        }
      ],
      "Default": "Done"
    },
    "WakeWaiting": {
      "Comment": "Wakes the execution that waits for its question turn. A stale token is not an error: that execution also polls.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskSuccess",
      "Arguments": {
        "TaskToken": "{% $e.wake_token %}",
        "Output": "{}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Done"
        }
      ],
      "Next": "Done"
    },
    "Consume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "consume",
          "chat_id": "{% $chat %}",
          "food": "{% $ctx.food %}",
          "disposal": "{% $ctx.intent %}"
        }
      },
      "Assign": {
        "kind": "consumed",
        "r": "{% $states.result.Payload %}"
      },
      "Next": "Reply"
    },
    "List": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "list",
          "chat_id": "{% $chat %}"
        }
      },
      "Assign": {
        "kind": "list",
        "r": "{% $states.result.Payload %}"
      },
      "Next": "Reply"
    },
    "Invite": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "invite",
          "chat_id": "{% $chat %}",
          "first_name": "{% $ctx.first_name %}"
        }
      },
      "Assign": {
        "kind": "invite",
        "r": "{% $states.result.Payload %}"
      },
      "Next": "Reply"
    },
    "Link": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "link",
          "chat_id": "{% $chat %}",
          "code": "{% $ctx.code %}",
          "first_name": "{% $ctx.first_name %}"
        }
      },
      "Assign": {
        "kind": "link",
        "r": "{% $states.result.Payload %}"
      },
      "Next": "Reply"
    },
    "PlainReply": {
      "Type": "Pass",
      "Assign": {
        "kind": "{% $ctx.intent %}",
        "r": {
          "task_token": "",
          "action": "",
          "wake_token": "",
          "review_id": ""
        }
      },
      "Next": "Reply"
    },
    "ResolveButton": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "action": "resolve",
          "chat_id": "{% $states.input.callback_query.from.id %}",
          "data": "{% $states.input.callback_query.data %}"
        }
      },
      "Assign": {
        "kind": "resolved",
        "r": "{% $states.result.Payload %}",
        "chat": "{% $states.input.callback_query.from.id %}",
        "cb": "{% $states.input.callback_query.id %}"
      },
      "Next": "Reply"
    },
    "Reply": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "{% $kind %}",
          "data": "{% $r %}",
          "callback_query_id": "{% $cb %}"
        }
      },
      "Next": "HasToken"
    },
    "HasToken": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $r.task_token != '' %}",
          "Next": "ReleaseToken"
        }
      ],
      "Default": "HasNext"
    },
    "ReleaseToken": {
      "Comment": "Wakes up the execution that is paused in AskWhatHappened. A stale token (already timed out) is not an error.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskSuccess",
      "Arguments": {
        "TaskToken": "{% $r.task_token %}",
        "Output": "{% $string({'action': $r.action}) %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HasNext"
        }
      ],
      "Next": "HasNext"
    },
    "HasNext": {
      "Comment": "After an answer: wake the next question that was waiting its turn, or ask about the next item flagged for review.",
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $r.wake_token != '' %}",
          "Next": "WakeNext"
        },
        {
          "Condition": "{% $r.review_id != '' %}",
          "Next": "AskReview"
        }
      ],
      "Default": "Done"
    },
    "WakeNext": {
      "Comment": "Wakes the execution that waits for its question turn. A stale token is not an error: that execution also polls.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskSuccess",
      "Arguments": {
        "TaskToken": "{% $r.wake_token %}",
        "Output": "{}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Done"
        }
      ],
      "Next": "Done"
    },
    "AskReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "ask",
          "data": "{% $r.review %}"
        }
      },
      "Next": "Done"
    },
    "NotifyError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "chat_id": "{% $chat %}",
          "kind": "error"
        }
      },
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
